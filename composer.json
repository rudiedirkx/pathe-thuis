{
    "name": "rdx/pathe-thuis",
    "type": "project",
    "require": {
        "rdx/db": "^2.0",
        "rdx/js-dom": "^1.6",
        "guzzlehttp/guzzle": "^7.4",
        "rdx/imdb-user-api": "dev-master"
    },
    "autoload": {
        "files": [
            "inc.functions.php"
        ],
        "psr-4": {
            "rdx\\pathethuis\\": "src/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.3.1"
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "symfony/var-dumper": "^6.4"
    }
}
